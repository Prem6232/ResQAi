# SentinelGrid / ResQ AI FastAPI Backend Environment Variables
PROJECT_NAME=SENTINELGRID
ENVIRONMENT=production

# PostgreSQL + PostGIS (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sentinelgrid_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (AWS S3, Cloudflare R2, Supabase Storage, or MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword123
S3_BUCKET_NAME=sentinelgrid-evidence

# Geospatial Routing (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Security / JWT
JWT_SECRET=replace_with_32_plus_char_secret
CORS_ORIGINS=["http://localhost:3000","https://res-q-ai-coral.vercel.app"]

# AI Pipeline & Vision Inference
AI_ADAPTER_MODE=mock
VISION_INFERENCE_URL=
GEMINI_API_KEY=
