# SentinelGrid / ResQ AI FastAPI Backend Environment Variables
PROJECT_NAME=SENTINELGRID
ENVIRONMENT=production

# PostgreSQL + PostGIS (asyncpg; accepts Neon/Supabase ?sslmode=require URLs too)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sentinelgrid_db

# Redis (optional: leave blank in single-container HF Spaces inline mode, or use Upstash rediss://...)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO, Cloudflare R2, AWS S3, or Supabase S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword123
S3_BUCKET_NAME=sentinelgrid-evidence
S3_ADDRESSING_STYLE=path

# Geospatial Routing (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Security / JWT
JWT_SECRET=replace_with_32_plus_char_secret
CORS_ORIGINS=["http://localhost:3000","https://res-q-ai-coral.vercel.app"]
CORS_ORIGIN_REGEX=^https://[a-zA-Z0-9-]+\.vercel\.app$|^http://(localhost|127\.0\.0\.1)(:\d+)?$

# AI Pipeline (set AI_ADAPTER_MODE=live + AI_INLINE_OUTBOX_POLL_SECONDS=2.0 when running without Celery)
AI_ADAPTER_MODE=live
AI_PRELOAD_ON_STARTUP=false
AI_INLINE_OUTBOX_POLL_SECONDS=0.0
AI_MODELS_ROOT=
HF_MODEL_REPO_ID=
HF_MODEL_REVISION=main
HF_TOKEN=
TEXT_CLASSIFIER_MODEL_DIR=
VOICE_TRANSCRIBER_MODEL_DIR=
DUPLICATE_MATCHER_MODEL_DIR=
VISION_DETECTOR_MODEL_DIR=
VISION_INFERENCE_URL=
GEMINI_API_KEY=
